NODE_ENV=development
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/mandate?sslmode=require
# Only for `npm run test:db`: a SEPARATE database that must be named mandate_test (the DB tests refuse any other name).
TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/mandate_test

# Phase 0 placeholder auth (single principal). SESSION_SECRET: >= 32 random chars
# (e.g. node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))").
SESSION_SECRET=replace_me
PRINCIPAL_EMAIL=owner@example.com
PRINCIPAL_LOGIN_SECRET=replace_me

PAYPAL_ENV=sandbox
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=replace_me
PAYPAL_CLIENT_SECRET=replace_me
PAYPAL_WEBHOOK_ID=replace_me

LLM_PROVIDER=gemini
GEMINI_API_KEY=replace_me
# alternative vendor (set LLM_PROVIDER=groq and use its own key; the Gemini key never substitutes):
# GROQ_API_KEY=replace_me
LLM_MODEL_AGENTS=replace_with_current_model_id
LLM_MODEL_VERIFIER=replace_with_current_model_id

# Ed25519 keypair (base64) for mandate signing. Generate with the provided script.
MANDATE_SIGNING_PRIVATE_KEY=replace_me
MANDATE_SIGNING_PUBLIC_KEY=replace_me
MANDATE_SIGNING_KEY_VERSION=v1

MAX_NEGOTIATION_ROUNDS=4
MAX_ARTIFACT_BYTES=200000
VERIFIER_PASSES=2

# Simulated Seller Agent (separate process: npm run seller). Loopback only. Rule-based, NOT an LLM.
SELLER_SERVICE_URL=http://127.0.0.1:4100
SELLER_PORT=4100
SELLER_MODE=honest
SELLER_FLOOR=22.00

# ---- Demo modes (milestone 2) -------------------------------------------------------------------------------------------------------------------------------
# PayPal: "mock" (DEFAULT, in-memory, never contacts PayPal) or "sandbox" (real Sandbox gateway). In sandbox mode every PayPal WRITE stays locked until you set
# PAYPAL_SANDBOX_WRITES=authorized, which you do only after approving the exact Sandbox transaction.
PAYPAL_MODE=mock
# PAYPAL_SANDBOX_WRITES=authorized
# Shorten the buyer's challenge window for a live demo (seconds, 0-3600; default 900).
DEMO_CHALLENGE_WINDOW_SECONDS=15
# Real AI for the Buyer Agent: set all three. Keep API keys in an env file OUTSIDE the cloud-synced project folder and start the app with
#   node --env-file=<that file> node_modules/next/dist/bin/next start      (and run the smoke test with:  npm run ai:smoke -- --env-file <that file>)
